# TugaConverte — configuração. Todas as chaves são opcionais.
# 0 = ilimitado. SóLiga um limite se realmente quiseres (Regra 6).

PORT=3000
HOST=0.0.0.0

# Onde ficam os ficheiros temporários. Volume em disco rápido.
DATA_DIR=data

# Conversões em paralelo. 0 = CPUs - 1. Sobe acima disso e só piora.
CONCURRENCY=0

# Limites desligados (0 = sem limite). Liga só se precisares de proteger a máquina.
MAX_UPLOAD_MB=0
JOB_TIMEOUT_SEC=0

# Minutos até um ficheiro ser apagado. Isto é privacidade, não quota.
TTL_MIN=120
